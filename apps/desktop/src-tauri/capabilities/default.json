{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window + toast window. App commands (invoke) are allowed by default; only window plumbing is listed here.",
  "windows": ["main", "toast"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-destroy"
  ]
}
