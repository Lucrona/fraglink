{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fraglink",
  "version": "0.3.0-beta.5",
  "identifier": "gg.fraglink.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fraglink",
        "url": "index.html",
        "create": false,
        "width": 435,
        "height": 572,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Lucrona",
    "copyright": "© 2026 Lucrona. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Fraglink: track your gaming hours",
    "longDescription": "Fraglink is a tiny tray companion that logs which games you play and for how long, locally on your PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../ui/fonts/RussoOne-OFL.txt": "fonts/RussoOne-OFL.txt",
      "../ui/fonts/LICENSE-wine-tahoma.txt": "fonts/LICENSE-wine-tahoma.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/splash-100.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Fraglink"
      },
      "wix": {
        "version": "0.3.0.5"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQkFDNUUzMTlEMUI2OTgKUldTWXR0RVo0OFc2L2xWVXNUc0hGUVp2QVg0RWVHYmJuMysyMFRLS1hiQ2dySzJhb21ZN0xMeFEK",
      "endpoints": [
        "https://playfraglink.com/updates/latest.json",
        "http://119.42.54.86/updates/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
