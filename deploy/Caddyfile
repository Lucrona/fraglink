# /etc/caddy/Caddyfile - Fraglink. The server itself listens on 127.0.0.1:8787.

import /etc/caddy/beta-gate.caddy

(fraglink) {
	encode gzip
	# desktop auto-update files (latest.json + signed installers), put there by scripts/publish-update.sh
	handle_path /updates/* {
		root * /var/www/fraglink-updates
		file_server
	}
	reverse_proxy 127.0.0.1:8787
}

# Website security headers (playfraglink.com and beta). HSTS: one year, this host only, no preload
# (raise or preload later once it's been fine for a while). CSP: scripts only from us, Cloudflare
# Turnstile and Wowhead tooltips, plus the one inline script in apps/site-web/layout.html (its
# sha256 below: change the hash if that line changes). No inline event handlers anywhere; app.js
# handles broken images and those buttons by data attributes. Images from any https host (Discord,
# Steam, Battle.net avatars, news images); inline styles allowed.
(site_security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-YbuIS4nuLvY/KMK82ZtaZogzewZbja9ix1WEc5yfD8o=' https://challenges.cloudflare.com https://wow.zamimg.com; style-src 'self' 'unsafe-inline' https://wow.zamimg.com https://use.typekit.net https://p.typekit.net; img-src 'self' data: blob: https:; font-src 'self' data: https://use.typekit.net https://wow.zamimg.com; connect-src 'self' wss://{host} https://nether.wowhead.com https://www.wowhead.com https://wow.zamimg.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https://steamcommunity.com; frame-ancestors 'none'"
	}
}

# Access log for update downloads only (everything else is skipped).
(updates_log) {
	@not_updates not path /updates/*
	skip_log @not_updates
	log {
		output file /var/log/caddy/{args.0} {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# playfraglink.com: the website (apps/site-web, same files as the beta preview) on HTTPS with an
# automatic Let's Encrypt certificate; http:// redirects to https automatically.
# The Fraglink server answers /api/*, game icons, device pairing (/pair + its legacy sign-in),
# Steam sign-in (/auth/*) and the old form posts (/web/*, /logout); Caddy serves the site files.
playfraglink.com {
	encode gzip
	import site_security
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	# Search engines: indexable (robots.txt and sitemap.xml are below). Private and signed-in
	# pages also say noindex in the header; profiles get theirs from the server (/u/*).
	@private path /admin /admin/* /admin.html /api/* /settings* /friends* /login* /forgot* /reset* /verify* /pair* /auth/* /web/* /logout /updates/* /404.html
	header @private X-Robots-Tag "noindex, nofollow"
	# one address per page: /index.html -> /, /download.html -> /download
	@index_html path /index.html
	redir @index_html / 308
	@page_html path_regexp page_html ^/([a-z0-9_-]+)\.html$
	redir @page_html /{re.page_html.1} 308
	# desktop auto-update files (latest.json + signed installers), put there by scripts/publish-update.sh
	handle_path /updates/* {
		root * /var/www/fraglink-updates
		file_server
	}
	# Brand images (Discord webhook avatars, embed thumbnails/banners), from the media kit.
	handle /brand/* {
		root * /var/www/fraglink-site
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# old coming-soon page assets (kept so cached pages/links don't break)
	handle /site/* {
		root * /var/www/fraglink-site
		header Cache-Control "public, max-age=3600"
		file_server
	}
	# official game icons from the server (/icons/g/ is the site's alias)
	handle_path /icons/g/* {
		rewrite * /icons/games{path}
		reverse_proxy 127.0.0.1:8787
	}
	# the server also answers the sitemap and the profile page (/u/*: u.html from the site files
	# with that profile's robots, canonical and preview tags; see apps/server/src/seo.rs)
	@server path /api/* /icons/* /pair /auth/* /web/* /logout /sitemap.xml /sitemaps/* /u/*
	handle @server {
		reverse_proxy 127.0.0.1:8787
	}
	# the server's own sign-in pages, only for device pairing / Steam sign-in (next=/pair..., /auth...)
	# and their form posts; normal /login and /signup are the website's pages
	@legacy_login {
		path /login /signup
		expression `{query}.matches("(^|&)next=(%2[Ff]|/)(pair|auth)")`
	}
	@legacy_post {
		method POST
		path /login /signup
	}
	@legacy_msg {
		path /
		query msg=*
	}
	handle @legacy_login {
		reverse_proxy 127.0.0.1:8787
	}
	handle @legacy_post {
		reverse_proxy 127.0.0.1:8787
	}
	handle @legacy_msg {
		reverse_proxy 127.0.0.1:8787
	}
	# staff tools: HTTP 404 for everyone; the page shows the admin UI only after the API confirms a staff role
	@admin path /admin /admin/ /admin.html
	handle @admin {
		root * /var/www/fraglink-beta
		rewrite * /admin.html
		header Cache-Control "no-store"
		file_server {
			status 404
		}
	}
	handle /news/* {
		root * /var/www/fraglink-beta
		rewrite * /news.html
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /var/www/fraglink-beta
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=86400"
		header /flags/* Cache-Control "public, max-age=604800"
		file_server
	}
	handle_errors {
		root * /var/www/fraglink-beta
		rewrite * /404.html
		file_server
	}
	import updates_log updates-https.log
}

# Private website preview (apps/site-web). Only reachable with the secret link
# (https://beta.playfraglink.com/?key=...), which sets a cookie; everyone else gets 404.
# The gate snippet with the key lives in /etc/caddy/beta-gate.caddy (root:caddy 0640, not in git).
beta.playfraglink.com {
	encode gzip
	import site_security
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	import beta_gate
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle_path /updates/* {
		root * /var/www/fraglink-updates
		header Cache-Control "no-cache"
		file_server
	}
	# official game icons from the server (/icons/g/ is the preview site's alias)
	handle /icons/games/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle_path /icons/g/* {
		rewrite * /icons/games{path}
		reverse_proxy 127.0.0.1:8787
	}
	# staff tools: HTTP 404 for everyone; the page shows the admin UI only after the API confirms a staff role
	@admin path /admin /admin/ /admin.html
	handle @admin {
		root * /var/www/fraglink-beta
		rewrite * /admin.html
		header Cache-Control "no-store"
		file_server {
			status 404
		}
	}
	handle /u/* {
		root * /var/www/fraglink-beta
		rewrite * /u.html
		header Cache-Control "no-cache"
		file_server
	}
	handle /news/* {
		root * /var/www/fraglink-beta
		rewrite * /news.html
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /var/www/fraglink-beta
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=86400"
		header /flags/* Cache-Control "public, max-age=604800"
		file_server
	}
	handle_errors {
		root * /var/www/fraglink-beta
		rewrite * /404.html
		file_server
	}
}

www.playfraglink.com {
	redir https://playfraglink.com{uri} permanent
}

# Plain-HTTP requests for the domain: straight to https://playfraglink.com, not logged.
# (Caddy still answers Let's Encrypt HTTP challenges here.)
http://playfraglink.com, http://www.playfraglink.com {
	skip_log
	redir https://playfraglink.com{uri} permanent
}

# Plain HTTP on the IP: KEEP. dev.9/dev.10 clients have http://119.42.54.86 baked in
# (API, websocket, updates). Catches every other HTTP request too, as before.
:80 {
	# the bare IP is for old app builds only, never for search engines
	header X-Robots-Tag "noindex, nofollow"
	import fraglink
	import updates_log updates-ip.log
}
